# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the "Session pooler" / port 5432 URI. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=renesola

# ── Groq (AI intelligent answer / chatbot) ──────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Auth ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=ReneSola Pakistan
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email (lead + service-request notifications) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
SALES_EMAIL=sales@example.com
SERVICE_EMAIL=service@example.com

# ── Localization ────────────────────────────────────────────
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ur,ar,zh,es,pt,fr,de
